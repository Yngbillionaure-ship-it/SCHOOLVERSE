<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090d18">

<title>SCHOOLVERSE</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #090d18;
    color: #ffffff;
    font-family: Arial, sans-serif;
    min-height: 100vh;
}

header {
    padding: 22px 18px;
    background: linear-gradient(135deg,#172443,#101629);
    border-bottom: 1px solid #35466b;
}

.logo {
    color: #e9c878;
    font-size: 27px;
    font-weight: bold;
    letter-spacing: 3px;
}

.subtitle {
    color: #aab6ce;
    font-size: 12px;
    margin-top: 6px;
    letter-spacing: 2px;
}

.player {
    margin: 18px;
    padding: 18px;
    background: #151f35;
    border: 1px solid #394969;
    border-radius: 14px;
}

.player h3 {
    color: #e9c878;
    margin-bottom: 10px;
}

.stats {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #bdc9dd;
    gap: 8px;
}

h2 {
    margin: 22px 18px 12px;
    font-size: 19px;
}

.modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 0 18px;
}

.card {
    min-height: 125px;
    padding: 17px 12px;
    border-radius: 13px;
    background: linear-gradient(145deg,#1c2c49,#111a2c);
    border: 1px solid #394969;
    color: white;
    cursor: pointer;
    text-align: left;
}

.card:active {
    transform: scale(.96);
}

.icon {
    font-size: 29px;
    margin-bottom: 12px;
}

.card h3 {
    font-size: 15px;
    margin-bottom: 6px;
}

.card p {
    color: #aab6ce;
    font-size: 11px;
    line-height: 1.4;
}

.adventure {
    margin: 22px 18px;
    padding: 20px;
    background: linear-gradient(135deg,#493a25,#1d2635);
    border: 1px solid #a88b51;
    border-radius: 14px;
}

.adventure h3 {
    color: #f0d38d;
    margin-bottom: 9px;
}

.adventure p {
    color: #ddd3bb;
    font-size: 13px;
    line-height: 1.6;
}

button {
    font-family: inherit;
}

.action {
    margin-top: 15px;
    padding: 11px 18px;
    background: #d3ae60;
    border: none;
    border-radius: 7px;
    color: #151515;
    font-weight: bold;
    cursor: pointer;
}

